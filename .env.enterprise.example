# PRISM Enterprise runtime.
# Copy to .env.enterprise only for local development. Never commit real values.

PRISM_ENVIRONMENT=development
PRISM_DATABASE_URL=postgresql+psycopg://prism@localhost:5432/prism

# Production: configure the approved enterprise IdP.
PRISM_OIDC_ISSUER=
PRISM_OIDC_AUDIENCE=
PRISM_OIDC_JWKS_URL=
PRISM_OIDC_ALGORITHMS=RS256,ES256
PRISM_ALLOW_DEV_AUTH=false

PRISM_ALLOWED_ORIGINS=
PRISM_TRUSTED_HOSTS=localhost,127.0.0.1

PRISM_MAX_UPLOAD_BYTES=26214400
PRISM_MAX_UPLOAD_ROWS=100000
PRISM_MAX_UPLOAD_COLUMNS=250
PRISM_MAX_CELL_CHARS=32768

# Generate independently. Store production values in a cloud secret manager/KMS-backed secret store.
PRISM_AUDIT_HMAC_KEY=
PRISM_DATA_ENCRYPTION_KEY_B64=
PRISM_DATA_ENCRYPTION_KEY_VERSION=v1

# P1 connectors, workers, quotas and observability.
# Production deployments must use an explicit comma-separated connector egress allowlist.
PRISM_CONNECTOR_ALLOWED_HOSTS=api.example.com
PRISM_CONNECTOR_TIMEOUT_SECONDS=15
PRISM_CONNECTOR_MAX_ROWS=1000

PRISM_JOB_POLL_SECONDS=1
PRISM_JOB_LEASE_SECONDS=120
PRISM_JOB_MAX_ATTEMPTS=3
PRISM_RATE_LIMIT_PER_MINUTE=120
PRISM_WORKSPACE_DAILY_JOB_QUOTA=1000

# Generate independently. This token protects the Prometheus metrics endpoint.
PRISM_METRICS_TOKEN=
PRISM_SLO_AVAILABILITY_TARGET=0.999
PRISM_SLO_LATENCY_P95_MS=750
PRISM_DEFAULT_RETENTION_DAYS=365
